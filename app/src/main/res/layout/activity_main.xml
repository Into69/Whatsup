<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/space">

    <WebView
        android:id="@+id/globe"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Padded by the system bar insets in MainActivity. -->
    <FrameLayout
        android:id="@+id/controls"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!--
            A column at the top right, leaving the bottom to the page's info sheet and legend: a
            toggle that folds the buttons away under it, then the buttons. It scrolls when a
            landscape screen is too short for all of it.
        -->
        <ScrollView
            android:id="@+id/map_controls"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:animateLayoutChanges="true"
                android:orientation="vertical"
                android:paddingBottom="6dp">

                <ImageButton
                    android:id="@+id/buttons_toggle"
                    style="@style/MapButton"
                    android:layout_height="28dp"
                    android:layout_marginBottom="6dp"
                    android:contentDescription="@string/hide_buttons"
                    android:padding="2dp"
                    android:src="@drawable/ic_expand" />

                <LinearLayout
                    android:id="@+id/map_buttons"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Most used first, related ones together; Settings, a screen of its own, last. -->
                    <ImageButton
                        android:id="@+id/search_button"
                        style="@style/MapButton.Stacked"
                        android:contentDescription="@string/search"
                        android:src="@drawable/ic_search" />

                    <ImageButton
                        android:id="@+id/in_view_button"
                        style="@style/MapButton.Stacked"
                        android:contentDescription="@string/in_view"
                        android:src="@drawable/ic_in_view" />

                    <ImageButton
                        android:id="@+id/sky_button"
                        style="@style/MapButton.Stacked"
                        android:contentDescription="@string/sky_view"
                        android:src="@drawable/ic_sky" />

                    <ImageButton
                        android:id="@+id/time_button"
                        style="@style/MapButton.Stacked"
                        android:contentDescription="@string/time_travel"
                        android:src="@drawable/ic_time" />

                    <ImageButton
                        android:id="@+id/events_button"
                        style="@style/MapButton.Stacked"
                        android:contentDescription="@string/events"
                        android:src="@drawable/ic_event" />

                    <ImageButton
                        android:id="@+id/recentre_button"
                        style="@style/MapButton.Stacked"
                        android:contentDescription="@string/recentre"
                        android:src="@drawable/ic_my_location" />

                    <ImageButton
                        android:id="@+id/night_button"
                        style="@style/MapButton.Stacked"
                        android:contentDescription="@string/night_vision_off"
                        android:src="@drawable/ic_night" />

                    <ImageButton
                        android:id="@+id/settings_button"
                        style="@style/MapButton.Stacked"
                        android:contentDescription="@string/settings"
                        android:src="@drawable/ic_settings" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <!--
            Data downloads, as a queue: a summary, the download under way, and what is waiting.
            At the bottom, clear of the attribution button, so the globe stays in view.
        -->
        <LinearLayout
            android:id="@+id/downloads"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="52dp"
            android:background="@drawable/panel_bg"
            android:orientation="vertical"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/download_summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <include
                android:id="@+id/download_current"
                layout="@layout/item_download" />

            <TextView
                android:id="@+id/download_queue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="#99FFFFFF"
                android:textSize="11sp"
                android:visibility="gone" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
