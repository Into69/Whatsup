<Project Sdk="Microsoft.NET.Sdk">

  <!-- The Android app's unit tests (app/src/test), against the desktop port, on the same sample data. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../WhatsUp.Desktop.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../app/src/test/resources/*" CopyToOutputDirectory="PreserveNewest" LinkBase="resources" />
  </ItemGroup>

</Project>
