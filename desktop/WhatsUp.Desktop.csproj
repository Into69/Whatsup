<Project Sdk="Microsoft.NET.Sdk">

  <!--
    What the Windows and Linux apps share: the Android app's page (app/src/main/assets, embedded, not
    copied), the desktop's own pages (web/), and the port of the Android code around the page (Host
    and the rest). Each shell (windows/, linux/) puts it in a window with that system's web view.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>WhatsUp.Desktop</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- Terrain tiles' PNGs, for Skyline: System.Drawing is Windows' only. -->
    <PackageReference Include="StbImageSharp" Version="2.30.15" />
  </ItemGroup>

  <!-- Served to the web views from inside the exe (Host.StaticFile, App.Resource). -->
  <ItemGroup>
    <EmbeddedResource Include="../app/src/main/assets/**/*" LogicalName="assets/%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="web/**/*" LogicalName="desktop/%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="../app/src/main/res/values/strings.xml" LogicalName="strings.xml" />
    <EmbeddedResource Include="../app/src/main/res/drawable/ic_*.xml" LogicalName="icons/%(Filename).xml" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="WhatsUp" />
    <InternalsVisibleTo Include="whatsup" />
    <InternalsVisibleTo Include="WhatsUp.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="tests/**" />
    <None Remove="tests/**" />
    <EmbeddedResource Remove="tests/**" />
  </ItemGroup>

</Project>
