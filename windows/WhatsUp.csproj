<Project Sdk="Microsoft.NET.Sdk">

  <!--
    WhatsUp for Windows: the shared desktop app (../desktop) in a WebView2 window, with Windows'
    location and notifications.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Windows 10 2004 and later, for the WinRT location and notification APIs. -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>WhatsUp</AssemblyName>
    <ApplicationIcon>whatsup.ico</ApplicationIcon>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!--
      Trimmed (see desktop/Directory.Build.props), which makes it smaller than one needing .NET
      installed (most of it is Windows' WinRT bindings). WinForms isn't marked safe to trim, but this
      app uses only a Form and WebView2's control.
    -->
    <_SuppressWinFormsTrimError>true</_SuppressWinFormsTrimError>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <!-- The WebView2 package's WPF control, unused here, wants a newer WindowsBase. -->
    <MSBuildWarningsAsMessages>MSB3277</MSBuildWarningsAsMessages>
  </PropertyGroup>

  <Import Project="../desktop/Directory.Build.props" />

  <ItemGroup>
    <PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.3" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
    <ProjectReference Include="../desktop/WhatsUp.Desktop.csproj" />
  </ItemGroup>

</Project>
