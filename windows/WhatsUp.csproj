<Project Sdk="Microsoft.NET.Sdk">

  <!--
    WhatsUp for Windows: the Android app's page (app/src/main/assets, shared, not copied) in a
    WebView2 window, with this project in place of the Android code around it.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Windows 10 2004 and later, for the WinRT location and notification APIs. -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>WhatsUp</RootNamespace>
    <AssemblyName>WhatsUp</AssemblyName>
    <ApplicationIcon>whatsup.ico</ApplicationIcon>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <!-- The same version as the Android app's. -->
    <Version>$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)../app/build.gradle.kts')), 'versionName = "([^"]+)"').Groups[1].Value)</Version>
    <Product>WhatsUp</Product>
    <Description>Satellite tracker on a 3D globe</Description>
    <!-- One WhatsUp.exe, WebView2's loader inside it. -->
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!--
      Self-contained, so nothing to install first, and trimmed and compressed, which makes it smaller
      than one needing .NET installed (most of it is Windows' WinRT bindings). WinForms isn't marked
      safe to trim, but this app uses only a Form and WebView2's control; JSON is built by hand with
      JsonNode, which needs the reflection-based converters for plain values left on.
    -->
    <SelfContained>true</SelfContained>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
    <_SuppressWinFormsTrimError>true</_SuppressWinFormsTrimError>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
    <!-- The WebView2 package's WPF control, unused here, wants a newer WindowsBase. -->
    <MSBuildWarningsAsMessages>MSB3277</MSBuildWarningsAsMessages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.3" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
  </ItemGroup>

  <!-- Served to the WebView from inside the exe (MainForm.Serve, App.Resource). -->
  <ItemGroup>
    <EmbeddedResource Include="../app/src/main/assets/**/*" LogicalName="assets/%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="web/**/*" LogicalName="desktop/%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="../app/src/main/res/values/strings.xml" LogicalName="strings.xml" />
    <EmbeddedResource Include="../app/src/main/res/drawable/ic_*.xml" LogicalName="icons/%(Filename).xml" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="WhatsUp.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="tests/**" />
    <None Remove="tests/**" />
    <EmbeddedResource Remove="tests/**" />
  </ItemGroup>

</Project>
